@if (Orders != null && Orders.Any()){
    <div class="modern-table-card">
        <div class="table-responsive">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>Ngày Đặt</th>
                        <th>Mã Đơn</th>
                        <th>Khách Hàng</th>
                        <th>Địa Chỉ Giao Hàng</th>
                        <th>Trạng Thái</th>
                        <th class="text-end">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Orders){
                        <OrderItemComponent @key="order.OrderId" Order="order"></OrderItemComponent>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="empty-state-box my-4">
        <div class="empty-state-icon">
            <i class="bi bi-inbox"></i>
        </div>
        <h4 class="empty-state-title">Không có đơn hàng nào</h4>
        <p class="empty-state-desc">Danh sách hiện tại đang trống.</p>
    </div>
}

@code {
    [Parameter]
    public IEnumerable<Order>? Orders { get; set; }
}
