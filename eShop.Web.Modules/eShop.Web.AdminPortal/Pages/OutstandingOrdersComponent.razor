@page "/outstandingorders"
@page "/admin"
@attribute [Authorize]

@inject IViewOutstandingOrdersUseCase viewOutstandingOrdersUseCase

<PageTitle>Đơn hàng chờ xử lý - eShop Admin</PageTitle>

<div class="py-3">
    <!-- Admin Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h2 class="h3 fw-bold mb-1">
                <i class="bi bi-inbox-fill text-warning me-2"></i>
                Đơn Hàng Chờ Xử Lý
            </h2>
            <p class="text-muted small mb-0">Quản lý và duyệt các đơn hàng mới từ khách hàng</p>
        </div>

        <!-- Admin Tabs -->
        <div class="btn-group bg-white p-1 rounded-pill border shadow-sm" role="group">
            <NavLink href="/outstandingorders" class="btn btn-sm rounded-pill btn-primary px-3 fw-semibold">
                <i class="bi bi-hourglass-split me-1"></i>
                Chờ xử lý @(orders != null ? $"({orders.Count()})" : "")
            </NavLink>
            <NavLink href="/processedorders" class="btn btn-sm rounded-pill btn-light text-secondary px-3 fw-semibold">
                <i class="bi bi-check2-circle me-1"></i>
                Đã xử lý
            </NavLink>
        </div>
    </div>

    <!-- Orders Table -->
    <OrderListComponent Orders="orders"></OrderListComponent>
</div>

@code {
    private IEnumerable<Order>? orders;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        orders = viewOutstandingOrdersUseCase.Execute();
    }
}
