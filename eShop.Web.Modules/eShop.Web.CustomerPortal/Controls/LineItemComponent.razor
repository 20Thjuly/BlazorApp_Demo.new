@using eShop.UseCases.ShoppingCartScreen.interfaces

@inject IDeleteProductUseCase deleteProductUseCase
@inject IUpdateQuantityUseCase updateQuantityUseCase

@if (LineItem != null && LineItem.Product != null)
{
    <div class="cart-item-row">
        <!-- Thumbnail -->
        <NavLink href="@($"/product/{LineItem.ProductId}")" class="cart-thumb-box">
            <img src="@LineItem.Product.ImageLink" 
                 alt="@LineItem.Product.Name" 
                 onerror="this.onerror=null; this.src='/images/placeholder.svg';" />
        </NavLink>

        <!-- Product Info -->
        <div class="cart-item-details">
            <div class="cart-item-name">
                <NavLink href="@($"/product/{LineItem.ProductId}")" class="text-decoration-none text-dark">
                    @LineItem.Product.Name
                </NavLink>
            </div>
            <div class="cart-item-unit-price">
                Đơn giá: <strong class="text-primary">@LineItem.Product.Price.ToString("c")</strong>
            </div>
        </div>

        <!-- Quantity Stepper -->
        <div class="quantity-stepper">
            <button type="button" class="stepper-btn" @onclick="HandleDecrement" title="Giảm số lượng">
                <i class="bi bi-dash"></i>
            </button>
            <input type="number" 
                   min="1" 
                   value="@LineItem.Quantity" 
                   @onchange="HandleQuantityChange" />
            <button type="button" class="stepper-btn" @onclick="HandleIncrement" title="Tăng số lượng">
                <i class="bi bi-plus"></i>
            </button>
        </div>

        <!-- Line Subtotal -->
        <div class="cart-item-subtotal">
            @((LineItem.Product.Price * LineItem.Quantity).ToString("c"))
        </div>

        <!-- Delete Action -->
        <button type="button" 
                class="btn-remove-item" 
                @onclick="@(() => DeleteProduct(LineItem.ProductId))" 
                title="Xóa sản phẩm">
            <i class="bi bi-trash3"></i>
        </button>
    </div>
}

@code {
    [Parameter]
    public OrderLineItem? LineItem { get; set; }

    [Parameter]
    public EventCallback<Order> OnDeleteProduct { get; set; }

    [Parameter]
    public EventCallback<Order> OnUpdateQuantity { get; set; }

    async void HandleQuantityChange(ChangeEventArgs e)
    {
        if (e.Value == null || string.IsNullOrEmpty(e.Value.ToString()) || LineItem == null) return;
        if (int.TryParse(e.Value.ToString(), out int qty))
        {
            if (qty < 0) return;
            var order = await updateQuantityUseCase.Execute(LineItem.ProductId, qty);
            await OnUpdateQuantity.InvokeAsync(order);
        }
    }

    async Task HandleIncrement()
    {
        if (LineItem == null) return;
        var order = await updateQuantityUseCase.Execute(LineItem.ProductId, LineItem.Quantity + 1);
        await OnUpdateQuantity.InvokeAsync(order);
    }

    async Task HandleDecrement()
    {
        if (LineItem == null) return;
        if (LineItem.Quantity > 1)
        {
            var order = await updateQuantityUseCase.Execute(LineItem.ProductId, LineItem.Quantity - 1);
            await OnUpdateQuantity.InvokeAsync(order);
        }
        else
        {
            DeleteProduct(LineItem.ProductId);
        }
    }

    async void DeleteProduct(int productId)
    {
        var order = await deleteProductUseCase.Execute(productId);
        await OnDeleteProduct.InvokeAsync(order);
    }
}
