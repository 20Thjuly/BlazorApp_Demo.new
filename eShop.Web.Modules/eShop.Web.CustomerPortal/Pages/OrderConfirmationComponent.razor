@page "/orderconfirm/{uniqueId}"

@inject IViewOrderConfirmationUseCase viewOrderConfirmationUseCase

<PageTitle>Xác nhận đơn hàng - eShop</PageTitle>

<!-- Checkout Stepper -->
<div class="checkout-stepper my-4">
    <div class="stepper-step completed">
        <span class="step-num"><i class="bi bi-check-lg"></i></span>
        <span>Giỏ Hàng</span>
    </div>
    <div class="stepper-divider active"></div>
    <div class="stepper-step completed">
        <span class="step-num"><i class="bi bi-check-lg"></i></span>
        <span>Thông Tin Giao Hàng</span>
    </div>
    <div class="stepper-divider active"></div>
    <div class="stepper-step completed">
        <span class="step-num"><i class="bi bi-check-lg"></i></span>
        <span>Hoàn Tất Đơn</span>
    </div>
</div>

@if (order != null)
{
    <!-- Success Hero -->
    <div class="order-success-hero">
        <div class="success-icon-wrap">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h1 class="h2 fw-bold mb-2">Đặt Hàng Thành Công!</h1>
        <p class="mb-3 opacity-75" style="max-width: 540px; margin: 0 auto;">
            Cảm ơn quý khách <strong>@order.CustomerName</strong>. Đơn hàng của bạn đã được tiếp nhận và nhân viên chăm sóc khách hàng sẽ liên hệ sớm nhất.
        </p>
        <div class="order-code-badge">
            <i class="bi bi-hash"></i>
            <span>Mã đơn: <strong>@UniqueId</strong></span>
        </div>
    </div>

    <!-- Order Delivery Timeline -->
    <div class="order-timeline">
        <div class="timeline-step done">
            <div class="timeline-icon"><i class="bi bi-bag-check-fill"></i></div>
            <span>Đã đặt hàng</span>
        </div>
        <div class="stepper-divider active"></div>
        <div class="timeline-step active">
            <div class="timeline-icon"><i class="bi bi-clipboard2-check-fill"></i></div>
            <span>Đang xác nhận</span>
        </div>
        <div class="stepper-divider"></div>
        <div class="timeline-step">
            <div class="timeline-icon"><i class="bi bi-box-seam-fill"></i></div>
            <span>Đang đóng gói</span>
        </div>
        <div class="stepper-divider"></div>
        <div class="timeline-step">
            <div class="timeline-icon"><i class="bi bi-truck"></i></div>
            <span>Đang giao hàng</span>
        </div>
    </div>

    <div class="row g-4 pb-5">
        <!-- Products & Customer details -->
        <div class="col-lg-8">
            <!-- Customer & Shipping info -->
            <div class="card border rounded-4 p-4 mb-4 bg-white shadow-sm">
                <h4 class="h6 fw-bold text-uppercase text-muted mb-3">
                    <i class="bi bi-geo-alt-fill text-primary me-2"></i>Địa Chỉ Giao Hàng
                </h4>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="text-muted small">Người nhận:</div>
                        <div class="fw-bold fs-6">@order.CustomerName</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Quốc gia:</div>
                        <div class="fw-semibold">@order.CustomerCountry</div>
                    </div>
                    <div class="col-12">
                        <div class="text-muted small">Địa chỉ chi tiết:</div>
                        <div class="fw-semibold">@order.CustomerAddress, @order.CustomerCity, @order.CustomerStateProvince</div>
                    </div>
                </div>
            </div>

            <!-- Items Table -->
            <div class="modern-table-card">
                <div class="p-3 bg-light border-bottom fw-bold">
                    <i class="bi bi-card-checklist text-primary me-2"></i>
                    Chi Tiết Sản Phẩm Đã Mua
                </div>
                <div class="table-responsive">
                    <table class="table-modern">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (order.LineItems != null)
                            {
                                @foreach (var item in order.LineItems)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@item.Product?.ImageLink" 
                                                     alt="@item.Product?.Name" 
                                                     style="width: 48px; height: 48px; object-fit: contain; background: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0; padding: 2px;" 
                                                     onerror="this.onerror=null; this.src='/images/placeholder.svg';" />
                                                <div class="fw-semibold">@item.Product?.Name</div>
                                            </div>
                                        </td>
                                        <td class="text-center fw-bold">@item.Quantity</td>
                                        <td class="text-end">@item.Price.ToString("c")</td>
                                        <td class="text-end fw-bold text-primary">@((item.Price * item.Quantity).ToString("c"))</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-flex gap-3">
                <NavLink href="/" class="btn btn-primary rounded-pill px-4 py-2 fw-bold">
                    <i class="bi bi-cart-plus me-2"></i> Tiếp Tục Mua Sắm
                </NavLink>
            </div>
        </div>

        <!-- Summary -->
        <div class="col-lg-4">
            <OrderSummaryComponent order="order" HidePlaceOrder="true"></OrderSummaryComponent>
        </div>
    </div>
}
else
{
    <div class="empty-state-box my-5">
        <div class="empty-state-icon">
            <i class="bi bi-search"></i>
        </div>
        <h3 class="empty-state-title">Đang tải thông tin đơn hàng...</h3>
        <p class="empty-state-desc">
            Vui lòng đợi giây lát hoặc kiểm tra lại mã đơn hàng.
        </p>
        <NavLink href="/" class="btn btn-primary rounded-pill px-4 py-2">
            <i class="bi bi-house-door me-2"></i> Về Trang Chủ
        </NavLink>
    </div>
}

@code {
    private Order? order;

    [Parameter]
    public string? UniqueId { get; set; }

    protected override void OnParametersSet() {
        base.OnParametersSet();

        if(!string.IsNullOrWhiteSpace(UniqueId)){
            order = viewOrderConfirmationUseCase.Execute(UniqueId);
        }
    }
}
