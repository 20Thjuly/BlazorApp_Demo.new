<div class="search-bar-wrapper">
	<div class="search-input-group">
		<i class="bi bi-search search-icon-inside"></i>
		<input type="text" 
		       class="search-input-field" 
		       id="filter" 
		       placeholder="Tìm kiếm sản phẩm (Ví dụ: Bronzer, Blush, Foundation, Eyeshadow...)" 
		       @bind-value="filter" 
		       @bind-value:event="oninput"
		       @onkeydown="HandleKeyDown" />

		@if (!string.IsNullOrEmpty(filter))
		{
			<button type="button" class="search-clear-btn" title="Xóa tìm kiếm" @onclick="HandleClear">
				<i class="bi bi-x-circle-fill"></i>
			</button>
		}

		<button type="button" class="search-btn-action" @onclick="HandleSearch">
			<i class="bi bi-search"></i>
			<span class="d-none d-sm-inline">Tìm kiếm</span>
		</button>
	</div>
</div>

@code {
	private string filter = string.Empty;

	[Parameter]
	public EventCallback<string> OnSearch { get; set; }

	private void HandleSearch()
	{
		OnSearch.InvokeAsync(filter);
	}

	private void HandleClear()
	{
		filter = string.Empty;
		OnSearch.InvokeAsync(filter);
	}

	private void HandleKeyDown(KeyboardEventArgs e)
	{
		if (e.Key == "Enter")
		{
			HandleSearch();
		}
	}
}
