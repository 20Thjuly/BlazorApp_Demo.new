@page "/products"
@rendermode InteractiveServer
@inject ISearchProduct searchProduct

<h3>Search Product Component</h3>
<br/>

<SearchBarComponent OnSearch="HandleSearch"></SearchBarComponent>

<br/>
<br/>

<table class="table">
    <thead>
        <tr>
            <th>
                Name
            </th>
            <th>
                Brand
            </th>
            <th>
                price
            </th>
        </tr>
    </thead>
    <tbody>
        @if (products != null && products.Any())
        {
            @foreach (var prob in products)
            {
                <ProductItemComponent @key="prob.Id" Product="prob"></ProductItemComponent>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center text-muted py-3">
                    Cannot find products
                </td>
            </tr>
        }

    </tbody>
</table>
    

@code {
    private IEnumerable<Product>? products;


    protected override void OnInitialized()
    {
        base.OnInitialized();

        products = searchProduct.Execute();
    }

    private void HandleSearch(string filter)
    {
        products = searchProduct.Execute(filter);
    }
}