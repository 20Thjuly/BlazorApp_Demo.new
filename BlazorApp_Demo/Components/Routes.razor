@using Microsoft.AspNetCore.Components.Routing

<Router AppAssembly="typeof(Program).Assembly"
        AdditionalAssemblies="new[] { 
            typeof(eShop.Web.CustomerPortal.Pages.SearchProductComponent).Assembly,
            typeof(eShop.Web.AdminPortal.Pages.OutstandingOrdersComponent).Assembly 
        }">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="GetLayout(routeData)">
            <NotAuthorized>
                <eShop.Web.Common.Controls.LoginComponent></eShop.Web.Common.Controls.LoginComponent>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    private Type GetLayout(RouteData routeData)
    {
        var pageAssembly = routeData.PageType.Assembly;
        if (pageAssembly == typeof(eShop.Web.CustomerPortal.Pages.SearchProductComponent).Assembly ||
            pageAssembly == typeof(eShop.Web.AdminPortal.Pages.OutstandingOrdersComponent).Assembly)
        {
            return typeof(Layout.EShopLayout);
        }

        return typeof(Layout.MainLayout);
    }
}
