<header class="eshop-header">
    <div class="eshop-container">
        <div class="eshop-header-inner">
            <!-- Brand Logo -->
            <a class="brand-link" href="/">
                <div class="brand-icon-box">
                    <i class="bi bi-gem"></i>
                </div>
                <div class="brand-text-wrap">
                    <span class="brand-title">eShop</span>
                    <span class="brand-sub">Beauty & Cosmetics</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="d-none d-md-flex align-items-center gap-2">
                <NavLink class="header-nav-link" href="/" Match="NavLinkMatch.All">
                    <i class="bi bi-grid-fill"></i>
                    <span>Tất cả sản phẩm</span>
                </NavLink>

                <!-- Course Labs Dropdown -->
                <div class="position-relative">
                    <button type="button" 
                            class="header-nav-link border-0 bg-transparent" 
                            @onclick="ToggleLabMenu">
                        <i class="bi bi-journal-code text-primary"></i>
                        <span>Bài tập Lab</span>
                        <i class="bi bi-chevron-down ms-1 small"></i>
                    </button>

                    @if (showLabMenu)
                    {
                        <div class="card border shadow-lg rounded-3 position-absolute top-100 start-0 mt-1 py-1" style="min-width: 220px; z-index: 1050; background: #ffffff;">
                            <NavLink class="dropdown-item px-3 py-2 small d-flex align-items-center" href="/forms" @onclick="CloseLabMenu">
                                <i class="bi bi-card-checklist text-primary me-2"></i>
                                <span>Forms & Validation</span>
                            </NavLink>
                            <NavLink class="dropdown-item px-3 py-2 small d-flex align-items-center" href="/counter" @onclick="CloseLabMenu">
                                <i class="bi bi-plus-slash-minus text-success me-2"></i>
                                <span>Counter Component</span>
                            </NavLink>
                            <NavLink class="dropdown-item px-3 py-2 small d-flex align-items-center" href="/weather" @onclick="CloseLabMenu">
                                <i class="bi bi-cloud-sun text-info me-2"></i>
                                <span>Weather Forecast</span>
                            </NavLink>
                            <NavLink class="dropdown-item px-3 py-2 small d-flex align-items-center" href="/dynamic" @onclick="CloseLabMenu">
                                <i class="bi bi-cpu text-warning me-2"></i>
                                <span>Dynamic Content</span>
                            </NavLink>
                            <NavLink class="dropdown-item px-3 py-2 small d-flex align-items-center" href="/todo" @onclick="CloseLabMenu">
                                <i class="bi bi-check2-square text-secondary me-2"></i>
                                <span>Todo List</span>
                            </NavLink>
                        </div>
                    }
                </div>

                <AuthorizeView>
                    <Authorized>
                        <NavLink class="header-nav-link" href="/outstandingorders">
                            <i class="bi bi-inbox-fill text-warning"></i>
                            <span>Đơn chờ xử lý</span>
                        </NavLink>
                        <NavLink class="header-nav-link" href="/processedorders">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>Đơn đã xử lý</span>
                        </NavLink>
                    </Authorized>
                </AuthorizeView>
            </nav>

            <!-- Right Actions -->
            <div class="header-actions">
                <AuthorizeView>
                    <Authorized>
                        <div class="user-status-pill d-none d-sm-inline-flex">
                            <i class="bi bi-person-fill-gear"></i>
                            <span>Admin: @context.User.Identity?.Name</span>
                        </div>
                        <NavLink class="btn btn-outline-danger btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1" href="/logout">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Đăng xuất</span>
                        </NavLink>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink href="/cart" class="text-decoration-none">
                            <eShop.Web.CustomerPortal.Controls.CartComponent></eShop.Web.CustomerPortal.Controls.CartComponent>
                        </NavLink>
                        <NavLink class="btn btn-outline-secondary btn-sm rounded-pill px-3 d-none d-sm-inline-flex align-items-center gap-1" href="/admin">
                            <i class="bi bi-shield-lock"></i>
                            <span>Admin Portal</span>
                        </NavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</header>

@code {
    private bool showLabMenu = false;

    private void ToggleLabMenu()
    {
        showLabMenu = !showLabMenu;
    }

    private void CloseLabMenu()
    {
        showLabMenu = false;
    }
}
