@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small fw-semibold">
                <i class="bi bi-mortarboard-fill text-primary me-1"></i>
                Lập Trình Web - Bài Tập Lab & Demos
            </span>
            <a href="/eshop" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold d-inline-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-bag-heart-fill"></i>
                <span>Xem Cửa Hàng eShop</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <article class="content px-4 py-3">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
